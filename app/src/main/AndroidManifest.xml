<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<!-- 安卓 13+ 发送通知需要运行时申请此权限 -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!-- 精确闹钟：保证提醒准点触发（未授权时退化为带漂移的普通闹钟） -->
	<uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
	<!-- 开机重排：手机重启后恢复全部每日提醒 -->
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
	<!-- 向系统时钟应用写入起床闹钟（第三阶段晚间规划用） -->
	<uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
	<!-- 访问用户配置的 AI 接口（第四阶段）：全应用唯一的网络出口 -->
	<uses-permission android:name="android.permission.INTERNET" />

	<!-- Android 11+ 包可见性：不声明则查询不到其他应用的启动入口（背单词跳转曾因此拿不到 intent） -->
	<queries>
		<intent>
			<action android:name="android.intent.action.MAIN" />
			<category android:name="android.intent.category.LAUNCHER" />
		</intent>
		<!-- 写入系统时钟的起床闹钟需要解析 SET_ALARM 处理方 -->
		<intent>
			<action android:name="android.intent.action.SET_ALARM" />
		</intent>
		<!-- 双保险方案：跳转时钟闹钟列表需要解析 SHOW_ALARMS 处理方 -->
		<intent>
			<action android:name="android.intent.action.SHOW_ALARMS" />
		</intent>
	</queries>

	<application
		android:name=".DailyControlApp"
		android:allowBackup="true"
		android:networkSecurityConfig="@xml/network_security_config"
		android:icon="@mipmap/ic_launcher"
		android:roundIcon="@mipmap/ic_launcher_round"
		android:label="@string/app_name"
		android:supportsRtl="true"
		android:theme="@style/Theme.DailyControl">

		<!-- singleTop：通知点击复用已运行实例，深链经 onNewIntent 传入 -->
		<activity
			android:name=".MainActivity"
			android:exported="true"
			android:launchMode="singleTop">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>

		<!-- 提醒到点接收器：应用内部触发，不对外导出 -->
		<receiver
			android:name=".schedule.ReminderReceiver"
			android:exported="false" />

		<!-- 开机重排接收器：必须导出以接收系统广播 -->
		<receiver
			android:name=".schedule.BootReceiver"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.BOOT_COMPLETED" />
			</intent-filter>
		</receiver>
	</application>

</manifest>
